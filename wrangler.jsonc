{
  // Cloudflare Workers Static Assets: the built site (dist/) served as-is, no Worker script.
  // www -> apex is a zone redirect rule (docs/cloudflare-launch.md), so every request stays a free static asset hit.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "birdi-hardwares",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash"
  },
  // only the custom domain serves the site: no second, indexable copy on workers.dev or preview URLs
  "workers_dev": false,
  "preview_urls": false,
  // both hosts serve the site; www is sent to the apex by a zone redirect rule (one canonical host)
  "routes": [
    { "pattern": "birdihardwares.com", "custom_domain": true },
    { "pattern": "www.birdihardwares.com", "custom_domain": true }
  ]
}
