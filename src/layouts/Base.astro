---
import '@fontsource-variable/jost/index.css'
// same hashed file the CSS above points at, preloaded so headings render in Jost from the first paint
import jostLatin from '@fontsource-variable/jost/files/jost-latin-wght-normal.woff2?url'
import '../styles/tokens.css'
import '../styles/global.css'
import '../styles/pages.css'
import EnquiryDialog from '../components/EnquiryDialog.jsx'
import Breadcrumbs from '../components/Breadcrumbs.astro'
import { site, INDEXABLE } from '../data/site.js'
import { CATEGORIES } from '../data/catalogue.js'
import { SHOP } from '../data/shop.js'
import { GUIDES } from '../data/guides.js'
import { abs, storeJsonLd, breadcrumbJsonLd } from '../lib/seo.js'
import { waHref, telHref } from '../lib/contact.js'
const wa = waHref(null)

interface Crumb { name: string; href: string }
interface Props {
  title: string
  description: string
  path: string
  crumbs?: Crumb[]
  jsonld?: object[]
  image?: string
  main?: string // id of the main content, for the skip link
  noindex?: boolean // pages that must never be indexed (the 404 page)
}
const { title, description, path, crumbs = [], jsonld = [], image = '/brand/birdi-social-1200x630.png', main = 'main', noindex = false } = Astro.props
const fullTitle = path === '/' ? title : `${title} | ${site.name}, Ludhiana`
const ld = [storeJsonLd(), ...(crumbs.length ? [breadcrumbJsonLd([{ name: 'Home', href: '/' }, ...crumbs])] : []), ...jsonld]
const nav = [
  ['/', 'Home'],
  ['/catalogue/', 'Catalogue'],
  ['/range/', 'Door hardware'],
  ['/guides/', 'Buying guides'],
  ['/about/', 'About'],
  ['/contact/', 'Visit'],
]
const current = (href: string) => (href === '/' ? path === '/' : path.startsWith(href))
const options = CATEGORIES.map((c) => c.title)
---

<!doctype html>
<html lang="en-IN">
  <head>
    <meta charset="UTF-8" />
    <link rel="preload" href={jostLatin} as="font" type="font/woff2" crossorigin />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="robots" content={INDEXABLE && !noindex ? 'index, follow' : 'noindex, nofollow'} />
    <meta name="theme-color" content="#eee7da" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={abs(path)} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={abs(path)} />
    <meta property="og:image" content={abs(image)} />
    <meta property="og:locale" content="en_IN" />
    <!-- Birdi escutcheon mark (public/brand/). Google Search uses a square favicon, a multiple of 48 px, linked from the home page. -->
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" type="image/png" href="/favicon-96.png" sizes="96x96" />
    <link rel="icon" type="image/png" href="/favicon-192.png" sizes="192x192" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    {ld.map((j) => <script type="application/ld+json" set:html={JSON.stringify(j)} />)}
    <script is:inline>
      // Enquire buttons work before the dialog has loaded: the request is queued and the dialog opens when ready.
      document.addEventListener('click', function (e) {
        var t = e.target.closest && e.target.closest('[data-enquire]')
        if (!t) return
        window.__enqPending = t.getAttribute('data-enquire') || ''
        window.dispatchEvent(new CustomEvent('birdi:enquire', { detail: { category: window.__enqPending } }))
      })
    </script>
  </head>
  <body>
    <a class="skip" href={`#${main}`}>Skip to content</a>
    <header class="nav">
      <a class="brand" href="/" aria-label={`${site.name} ${site.locality}, home`}>
        <img src="/brand/birdi-logo-line.svg" alt={site.name} width="1184" height="200" decoding="async" />
      </a>
      <nav aria-label="Main" class="nav-links">
        {nav.map(([href, label]) => <a href={href} aria-current={current(href) ? 'page' : undefined}>{label}</a>)}
      </nav>
      <span class="nav-contact">
        {telHref && <a class="nav-phone" href={telHref} aria-label={`Call ${site.phone.display}`}>{site.phone.display}</a>}
        {wa && (
          <a class="nav-wa" href={wa} target="_blank" rel="noopener" aria-label="Chat with Birdi Hardwares on WhatsApp" title="WhatsApp">
            <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M12 2.2a9.8 9.8 0 0 0-8.4 14.8L2.3 21.7l4.8-1.3A9.8 9.8 0 1 0 12 2.2Zm0 17.8a8 8 0 0 1-4.1-1.1l-.3-.2-2.8.8.8-2.8-.2-.3A8 8 0 1 1 12 20Zm4.4-6c-.2-.1-1.4-.7-1.7-.8-.2-.1-.4-.1-.5.1l-.8.9c-.1.2-.3.2-.5.1a6.6 6.6 0 0 1-3.3-2.9c-.2-.4.2-.4.7-1.2.1-.2 0-.3 0-.4l-.8-1.8c-.2-.5-.4-.4-.5-.4h-.5a.9.9 0 0 0-.6.3 2.7 2.7 0 0 0-.8 2c0 1.2.9 2.3 1 2.5.1.2 1.7 2.7 4.2 3.7 1.6.7 2.2.7 3 .6.5-.1 1.4-.6 1.6-1.1.2-.6.2-1 .1-1.1l-.4-.2Z" fill="currentColor"/></svg>
          </a>
        )}
      </span>
      <a class="btn btn-primary nav-cta" href="/enquiry/">Enquire</a>
      <details class="menu">
        <summary aria-label="Menu"><span class="menu-bars" aria-hidden="true"></span><span class="menu-word">Menu</span></summary>
        <nav aria-label="Mobile" class="menu-panel">
          {nav.map(([href, label]) => <a href={href} aria-current={current(href) ? 'page' : undefined}>{label}</a>)}
          <a href="/faq/">Questions</a>
          {telHref && <a href={telHref}>Call {site.phone.display}</a>}
          {wa && <a href={wa} target="_blank" rel="noopener">WhatsApp<span class="sr-only"> (opens in a new tab)</span></a>}
          <a class="btn btn-primary" href="/enquiry/">Enquire</a>
        </nav>
      </details>
    </header>

    {crumbs.length > 0 && <Breadcrumbs crumbs={crumbs} />}

    <slot />

    <footer class="site-foot">
      <div class="foot-grid">
        <div class="foot-col foot-visit">
          <img src="/brand/birdi-logo-stacked-on-dark.svg" alt={site.name} width="431" height="175" loading="lazy" decoding="async" class="foot-logo" />
          <address>{site.address[0]}<br />{site.address[1]}</address>
          {telHref && <p class="foot-phone"><a href={telHref}>{site.phone.display}</a> · <a href={wa} target="_blank" rel="noopener">WhatsApp<span class="sr-only"> (opens in a new tab)</span></a></p>}
          <a class="link" href="/contact/">How to find the shop</a>
        </div>
        <nav class="foot-col" aria-label="Catalogue">
          <h2>Catalogue</h2>
          {SHOP.map((c) => <a href={`/catalogue/${c.slug}/`}>{c.title}</a>)}
        </nav>
        <nav class="foot-col" aria-label="Door hardware">
          <h2>Door hardware</h2>
          {CATEGORIES.map((c) => <a href={`/range/${c.slug}/`}>{c.title}</a>)}
        </nav>
        <nav class="foot-col" aria-label="Buying guides">
          <h2>Buying guides</h2>
          {GUIDES.map((g) => <a href={`/guides/${g.slug}/`}>{g.title}</a>)}
        </nav>
        <nav class="foot-col" aria-label="Help">
          <h2>Help</h2>
          <a href="/needs/main-door/">Main doors</a>
          <a href="/needs/interior-doors/">Interior doors</a>
          <a href="/needs/replacement-and-renovation/">Replacement</a>
          <a href="/needs/trade-enquiries/">Projects and trade</a>
          <a href="/faq/">Questions</a>
          <a href="/enquiry/">Request a quotation</a>
        </nav>
      </div>
      <div class="foot-base">
        <p class="demo-note">{site.name}, Lakkar Bazar, Ludhiana. Prices on request.</p>
        <p><a href="/privacy/">Privacy</a> · <a href="/terms/">Website terms</a></p>
      </div>
    </footer>

    {wa && (
      <a class="wa-fab" href={wa} target="_blank" rel="noopener" aria-label="WhatsApp Birdi Hardwares (opens in a new tab)">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2.2a9.8 9.8 0 0 0-8.4 14.8L2.3 21.7l4.8-1.3A9.8 9.8 0 1 0 12 2.2Zm0 17.8a8 8 0 0 1-4.1-1.1l-.3-.2-2.8.8.8-2.8-.2-.3A8 8 0 1 1 12 20Zm4.4-6c-.2-.1-1.4-.7-1.7-.8-.2-.1-.4-.1-.5.1l-.8.9c-.1.2-.3.2-.5.1a6.6 6.6 0 0 1-3.3-2.9c-.2-.4.2-.4.7-1.2.1-.2 0-.3 0-.4l-.8-1.8c-.2-.5-.4-.4-.5-.4h-.5a.9.9 0 0 0-.6.3 2.7 2.7 0 0 0-.8 2c0 1.2.9 2.3 1 2.5.1.2 1.7 2.7 4.2 3.7 1.6.7 2.2.7 3 .6.5-.1 1.4-.6 1.6-1.1.2-.6.2-1 .1-1.1l-.4-.2Z" fill="currentColor"/></svg>
      </a>
    )}
    <script is:inline>
      // Keep the WhatsApp shortcut out of the way: hidden while the home 3D hero (with its own controls) fills the
      // screen, and while the footer is in view (it has the number and links itself).
      (function () {
        var fab = document.querySelector('.wa-fab'); if (!fab || !('IntersectionObserver' in window)) return
        var hero = document.querySelector('.hero'), foot = document.querySelector('.site-foot'), inFoot = false, queued = false
        var set = function () {
          queued = false
          var inHero = hero ? hero.getBoundingClientRect().bottom > innerHeight * 0.3 : false // hero still fills a good part of the screen
          fab.classList.toggle('is-hidden', inHero || inFoot)
        }
        var later = function () { if (!queued) { queued = true; requestAnimationFrame(set) } }
        if (hero) { addEventListener('scroll', later, { passive: true }); addEventListener('resize', later) }
        if (foot) new IntersectionObserver(function (e) { inFoot = e[0].isIntersecting; later() }).observe(foot)
        if (hero) fab.classList.add('is-hidden') // on the home page the first check hides it anyway (hero below); no flash meanwhile
        later() // next frame: measuring now would force a layout of the whole page while it is still parsing
      })()
    </script>

    <EnquiryDialog client:idle categories={options} endpoint={site.enquiryEndpoint} />
  </body>
</html>
