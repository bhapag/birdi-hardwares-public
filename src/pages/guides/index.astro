---
import Base from '../../layouts/Base.astro'
import PageStage from '../../components/PageStage.astro'
import { GUIDES } from '../../data/guides.js'
import { IMAGES } from '../../data/catalogue.js'
---
<Base title="Door hardware buying guides" description="Practical guides to choosing door locks, digital locks, door closers, hinges and finishes, and what to measure before you buy." path="/guides/" crumbs={[{ name: 'Buying guides', href: '/guides/' }]}>
  <main>
    <PageStage kicker="Buying guides" title="Choose with confidence." lead="Short, practical guides. No brand claims, no sales talk: what to look for and what to measure." actions={false} />
    <section class="band">
      <ul class="guide-grid">
        {GUIDES.map((g) => { const img = IMAGES[g.image]; return (
          <li class="guide-card">
            <a href={`/guides/${g.slug}/`}>
              <span class="guide-img">
                <picture>
                  <source type="image/avif" srcset={`${img.src}-720.avif`} />
                  <source type="image/webp" srcset={`${img.src}-720.webp`} />
                  <img src={`${img.src}-1200.jpg`} alt="" width="1200" height="1500" loading="lazy" decoding="async" />
                </picture>
              </span>
              <span class="guide-title">{g.title}</span>
              <span class="guide-lead">{g.lead}</span>
            </a>
          </li>) })}
      </ul>
    </section>
  </main>
</Base>
