---
// WhatsApp (message prefilled for the visitor to review and send), Call, and the quotation form.
import { site } from '../data/site.js'
import { waHref, telHref } from '../lib/contact.js'
interface Props { item?: string | null; form?: string; invert?: boolean }
const { item = null, form = '/enquiry/', invert = false } = Astro.props
const wa = waHref(item)
---
<div class={`contact-actions${invert ? ' invert' : ''}`}>
  {wa && (
    <a class="btn btn-primary btn-wa" href={wa} target="_blank" rel="noopener">
      <svg class="wa-glyph" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2.2a9.8 9.8 0 0 0-8.4 14.8L2.3 21.7l4.8-1.3A9.8 9.8 0 1 0 12 2.2Zm0 17.8a8 8 0 0 1-4.1-1.1l-.3-.2-2.8.8.8-2.8-.2-.3A8 8 0 1 1 12 20Zm4.4-6c-.2-.1-1.4-.7-1.7-.8-.2-.1-.4-.1-.5.1l-.8.9c-.1.2-.3.2-.5.1a6.6 6.6 0 0 1-3.3-2.9c-.2-.4.2-.4.7-1.2.1-.2 0-.3 0-.4l-.8-1.8c-.2-.5-.4-.4-.5-.4h-.5a.9.9 0 0 0-.6.3 2.7 2.7 0 0 0-.8 2c0 1.2.9 2.3 1 2.5.1.2 1.7 2.7 4.2 3.7 1.6.7 2.2.7 3 .6.5-.1 1.4-.6 1.6-1.1.2-.6.2-1 .1-1.1l-.4-.2Z" fill="currentColor"/></svg>
      WhatsApp us<span class="sr-only">{item ? ` about ${item}` : ''} (opens in a new tab)</span>
    </a>
  )}
  {telHref && <a class="btn btn-quiet" href={telHref}>Call {site.phone.display}</a>}
  <a class="link" href={form}>Quotation form</a>
</div>
